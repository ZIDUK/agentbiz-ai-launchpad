#!/usr/bin/env bash
# Pre-push guard: refuse to push if a malware scan flags the working tree.
# Mirrors the check in .github/workflows/security-scan.yml — keep them in sync.
#
# To bypass in an emergency: `git push --no-verify`.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCAN="$REPO_ROOT/scripts/scan-malware.sh"

if [[ ! -x "$SCAN" ]]; then
  echo "pre-push: $SCAN not executable, run: chmod +x scripts/scan-malware.sh"
  exit 0
fi

echo "pre-push: running malware scan..."
if ! "$SCAN" "$REPO_ROOT"; then
  echo ""
  echo "Push blocked. See scan output above."
  echo "If you believe this is a false positive, edit scripts/scan-malware.sh."
  echo "To override: git push --no-verify"
  exit 1
fi
