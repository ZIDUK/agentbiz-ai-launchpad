{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/*": [
        "./src/components/*"
      ],
      "@/pages/*": [
        "./src/pages/*"
      ],
      "@/i18n/*": [
        "./src/i18n/*"
      ],
      "@/data/*": [
        "./src/data/*"
      ],
      "@/assets/*": [
        "./src/assets/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/lib/analytics": [
        "./src/lib/analytics.ts"
      ],
      "@/lib/seo-meta": [
        "./src/lib/seo-meta.ts"
      ],
      "@/lib/site-navigation-schema": [
        "./src/lib/site-navigation-schema.ts"
      ],
      "@/hooks/*": [
        "./hooks/*",
        "./src/hooks/*"
      ],
      "@/*": [
        "./*"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "poc/scroll-experience/**/*.ts",
    "poc/scroll-experience/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/hooks/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/pages/**/*.ts",
    "src/pages/**/*.tsx",
    "src/i18n/**/*.ts",
    "src/i18n/**/*.tsx",
    "src/data/**/*.ts",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "tests/**/*.ts",
    "next.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "src/App.tsx",
    "src/main.tsx",
    "src/SiteRoutes.tsx",
    "src/pages/Admin.tsx",
    "src/pages/Index.tsx",
    "poc/scroll-experience/ScrollPocApp.tsx",
    "poc/scroll-experience/main.tsx",
    "poc/scroll-experience/PocProviders.tsx"
  ]
}
