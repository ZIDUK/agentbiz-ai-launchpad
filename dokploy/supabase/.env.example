############
# AgentBiz Supabase self-hosting — Dokploy environment template
# Momo Tea proven stack (see docker-compose.yml)
#
# 1. Copy to .env:  cp .env.example .env
# 2. Generate secrets:
#    git clone --depth 1 https://github.com/supabase/supabase /tmp/supabase
#    cd /tmp/supabase/docker && sh utils/generate-keys.sh
# 3. In Dokploy: paste the same values into the Compose app Environment tab.
#
# Docs: https://supabase.com/docs/guides/self-hosting/docker
############

############
# AgentBiz / Dokploy identifiers
############

CONTAINER_PREFIX=agentbiz

############
# Secrets — CHANGE ALL VALUES BEFORE FIRST DEPLOY
############

POSTGRES_PASSWORD=CHANGE_ME_super-secret-postgres-password

JWT_SECRET=CHANGE_ME_super-secret-jwt-token-with-at-least-32-characters-long

ANON_KEY=CHANGE_ME_generate-with-supabase-utils-generate-keys-sh
SERVICE_ROLE_KEY=CHANGE_ME_generate-with-supabase-utils-generate-keys-sh

DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME_strong-dashboard-password

SECRET_KEY_BASE=CHANGE_ME_openssl_rand_base64_48
VAULT_ENC_KEY=CHANGE_ME_openssl_rand_hex_16
LOGFLARE_API_KEY=CHANGE_ME_openssl_rand_base64_24
# Required by Vector log shipper (use the same value as LOGFLARE_API_KEY)
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME_openssl_rand_base64_24

# Optional opaque API keys (leave empty for legacy HS256 JWT keys only)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

############
# AgentBiz URLs — pre-filled for production
############

SUPABASE_PUBLIC_URL=https://agent-supabase.agentbiz.io
API_EXTERNAL_URL=https://agent-supabase.agentbiz.io
SUPABASE_HOST=agent-supabase.agentbiz.io
SITE_URL=https://agentbiz.io

ADDITIONAL_REDIRECT_URLS=https://agentbiz.io/**,https://www.agentbiz.io/**,https://agentbiz.io/admin,https://agentbiz.io/admin/**

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Supavisor (connection pooler)
############

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=agentbiz

############
# Studio
############

STUDIO_DEFAULT_ORGANIZATION=AgentBiz
STUDIO_DEFAULT_PROJECT=AgentBiz Production
OPENAI_API_KEY=

############
# Auth
############

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@agentbiz.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=AgentBiz
ENABLE_ANONYMOUS_USERS=false

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# Edge Functions
############

FUNCTIONS_VERIFY_JWT=false

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,storage,graphql_public

############
# Logs / Analytics / Vector
############

DOCKER_SOCKET_LOCATION=/var/run/docker.sock

############
# imgproxy
############

IMGPROXY_ENABLE_WEBP_DETECTION=true
